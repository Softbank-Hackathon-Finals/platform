{
  "apiVersion": "cert-manager.io/v1",
  "kind": "Certificate",
  "metadata": {
    "name": "bravo-app-telemetry-ca",
    "namespace": "cert-manager",
    "labels": {
      "tier": "observability",
      "role": "collector",
      "domain": "customer"
    }
  },
  "spec": {
    "isCA": true,
    "commonName": "bravo-app-telemetry-ca-source",
    "secretName": "bravo-app-telemetry-ca",
    "duration": "8760h",
    "renewBefore": "720h",
    "usages": [
      "cert sign",
      "crl sign"
    ],
    "privateKey": {
      "algorithm": "ECDSA",
      "size": 256,
      "rotationPolicy": "Never"
    },
    "issuerRef": {
      "group": "cert-manager.io",
      "kind": "ClusterIssuer",
      "name": "bravo-app-telemetry-bootstrap"
    }
  }
}
