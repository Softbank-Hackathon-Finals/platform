# 목적지 프로필: k3d 시험용. SeaweedFS · OpenBao 대신 testing/standins.yaml의 대역 서버를 가리킨다.
# 포트는 실제 서비스의 기본 컨테이너 포트(SeaweedFS S3 8333, OpenBao 8200)와 맞췄다.
# T9 구축 뒤 profiles/onprem.env를 같은 형식으로 만든다.
SEAWEEDFS_NAMESPACE=seaweedfs
SEAWEEDFS_LABEL_KEY=app.kubernetes.io/name
SEAWEEDFS_LABEL_VALUE=seaweedfs-s3
SEAWEEDFS_PORT=8333
OPENBAO_NAMESPACE=openbao
OPENBAO_LABEL_KEY=app.kubernetes.io/name
OPENBAO_LABEL_VALUE=openbao
OPENBAO_PORT=8200
