{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bravo:t10:plan-snapshot:1.0",
  "title": "T10 local plan snapshot proposal",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "workload_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "source_environment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "target_environment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "collection_scope_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "profile_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "state": {
      "enum": [
        "COLLECT",
        "ANALYZE",
        "PROPOSE",
        "REHEARSE",
        "GATE",
        "AWAIT_APPROVAL",
        "SHIFT",
        "CUTOVER",
        "WATCH",
        "FAILBACK",
        "SAFE_HOLD",
        "NEEDS_HUMAN",
        "DONE",
        "DONE_ROLLED_BACK"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}:[1-9][0-9]{0,15}$"
    },
    "recheck_profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "recheck_profile_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    }
  },
  "dependentRequired": {
    "profile_id": [
      "profile_version"
    ],
    "profile_version": [
      "profile_id"
    ],
    "recheck_profile_id": [
      "recheck_profile_version",
      "profile_id",
      "profile_version"
    ],
    "recheck_profile_version": [
      "recheck_profile_id",
      "profile_id",
      "profile_version"
    ]
  },
  "required": [
    "schema_version",
    "plan_id",
    "workload_id",
    "source_environment_id",
    "target_environment_id",
    "plan_digest",
    "collection_scope_digest",
    "state",
    "version",
    "created_at",
    "updated_at",
    "last_event_id"
  ]
}
