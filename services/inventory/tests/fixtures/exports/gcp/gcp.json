{
  "project_id": "example-project",
  "project_policy": {"bindings": [
    {"role": "roles/logging.logWriter", "members": ["serviceAccount:chat-gsa@example-project.iam.gserviceaccount.com"]}
  ]},
  "service_accounts": {
    "chat-gsa@example-project.iam.gserviceaccount.com": {"iam_policy": {"bindings": [
      {"role": "roles/iam.workloadIdentityUser", "members": ["serviceAccount:example-project.svc.id.goog[chat/chat]"]}
    ]}},
    "eso-gsa@example-project.iam.gserviceaccount.com": {"iam_policy": {"bindings": []}}
  },
  "resource_policies": [
    {"resource": "//cloudresourcemanager.googleapis.com/projects/example-project", "policy": {"bindings": [
      {"role": "roles/logging.logWriter", "members": ["serviceAccount:chat-gsa@example-project.iam.gserviceaccount.com"]}]}},
    {"resource": "//storage.googleapis.com/projects/_/buckets/demo-chat-attachments", "policy": {"bindings": [
      {"role": "roles/storage.objectAdmin", "members": ["serviceAccount:chat-gsa@example-project.iam.gserviceaccount.com"]}]}},
    {"resource": "//storage.googleapis.com/projects/_/buckets/demo-chat-backups", "policy": {"bindings": [
      {"role": "roles/storage.objectViewer", "members": ["serviceAccount:chat-gsa@example-project.iam.gserviceaccount.com", "allUsers"]}]}},
    {"resource": "//secretmanager.googleapis.com/projects/example-project/secrets/demo-chat-db", "policy": {"bindings": [
      {"role": "roles/secretmanager.secretAccessor", "members": ["serviceAccount:chat-gsa@example-project.iam.gserviceaccount.com", "serviceAccount:eso-gsa@example-project.iam.gserviceaccount.com"]}]}},
    {"resource": "//cloudkms.googleapis.com/projects/example-project/locations/asia-northeast3/keyRings/chat/cryptoKeys/attachments", "policy": {"bindings": [
      {"role": "roles/cloudkms.cryptoKeyEncrypterDecrypter", "members": ["serviceAccount:chat-gsa@example-project.iam.gserviceaccount.com"]}]}}
  ],
  "buckets": {"demo-chat-attachments": {"location": "ASIA-NORTHEAST3", "versioning": true, "owner_email": "x@example.invalid"}},
  "secrets": {"demo-chat-db": {"replication": "automatic"}},
  "kms_keys": {"projects/example-project/locations/asia-northeast3/keyRings/chat/cryptoKeys/attachments": {"purpose": "ENCRYPT_DECRYPT", "state": "ENABLED"}}
}
