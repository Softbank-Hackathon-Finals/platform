{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bravo.example.invalid/schemas/audit-record/1.0",
  "title": "T24 audit record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "plan_id", "run_id", "sequence", "recorded_at",
               "source", "kind", "origin_id", "payload", "payload_sha256", "prev_sha256", "sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}:[1-9][0-9]{0,8}$"},
    "plan_id": {"$ref": "#/$defs/identifier"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 999999999},
    "recorded_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "source": {"enum": ["platform.events", "agent.tools", "gate", "executor", "rehearsal", "infra"]},
    "kind": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
    "origin_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,191}$"},
    "payload": {"type": "object"},
    "payload_sha256": {"$ref": "#/$defs/sha256"},
    "prev_sha256": {"$ref": "#/$defs/sha256"},
    "sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
