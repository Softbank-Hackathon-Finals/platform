{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUnusedLocals": true, "skipLibCheck": true, "esModuleInterop": true,
    "resolveJsonModule": true, "isolatedModules": true, "types": ["node", "vite/client"], "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["src", "forge.config.mts", "vite.*.mts"]
}
