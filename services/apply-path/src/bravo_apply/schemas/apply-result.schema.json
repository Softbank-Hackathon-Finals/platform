{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "T31 apply result v1.2 (one record per application_id; 1.1 records stay readable)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "application_id", "approval_id", "verification_id", "plan_id", "outcome",
               "reason", "change", "deployed_digest", "job_passed", "gate_recheck", "cluster", "target",
               "cluster_mutation_attempted", "previous_image", "observed_digests", "started_at", "deadline_at",
               "finished_at", "steps"],
  "properties": {
    "schema_version": {"enum": ["1.1", "1.2"]},
    "application_id": {"$ref": "#/$defs/identifier"},
    "approval_id": {"$ref": "#/$defs/identifier"},
    "verification_id": {"$ref": "#/$defs/identifier"},
    "plan_id": {"$ref": "#/$defs/identifier"},
    "outcome": {"enum": ["APPLIED", "REFUSED", "SAFE_HOLD", "UNKNOWN"]},
    "reason": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
    "change": {"anyOf": [
      {"type": "null"},
      {"type": "object", "additionalProperties": false, "required": ["diff_hash", "image_digest"],
       "properties": {"diff_hash": {"$ref": "#/$defs/digest"}, "image_digest": {"$ref": "#/$defs/digest"}}},
      {"type": "object", "additionalProperties": false, "required": ["diff_hash", "image_digest", "change_kind", "policy_digest"],
       "properties": {"diff_hash": {"$ref": "#/$defs/digest"}, "image_digest": {"$ref": "#/$defs/digest"},
                      "change_kind": {"const": "bucket_policy"}, "policy_digest": {"$ref": "#/$defs/digest"}}}]},
    "deployed_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "job_passed": {"type": "boolean"},
    "gate_recheck": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
                     "required": ["plan_id", "application_id", "image_digest", "tests"],
                     "properties": {"plan_id": {"$ref": "#/$defs/identifier"}, "application_id": {"$ref": "#/$defs/identifier"},
                                    "image_digest": {"$ref": "#/$defs/digest"}, "policy_digest": {"$ref": "#/$defs/digest"},
                                    "tests": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{2,4}-[0-9]{2}\\.[0-9]{1,2}$"}, "minItems": 1}}}]},
    "cluster": {"enum": ["kubectl", "fake", "custom"]},
    "target": {"anyOf": [
      {"type": "object", "additionalProperties": false, "required": ["namespace", "deployment", "container", "repository"],
       "properties": {"namespace": {"$ref": "#/$defs/text"}, "deployment": {"$ref": "#/$defs/text"},
                      "container": {"$ref": "#/$defs/text"}, "repository": {"$ref": "#/$defs/text"}}},
      {"type": "object", "additionalProperties": false,
       "required": ["kind", "namespace", "endpoint", "probe_key", "bucket", "policy_bucket", "secret", "secret_key", "workload", "container"],
       "properties": {"kind": {"const": "bucket_policy"}, "namespace": {"$ref": "#/$defs/text"}, "endpoint": {"$ref": "#/$defs/text"},
                      "probe_key": {"$ref": "#/$defs/text"}, "bucket": {"$ref": "#/$defs/text"}, "policy_bucket": {"$ref": "#/$defs/text"},
                      "secret": {"$ref": "#/$defs/text"}, "secret_key": {"$ref": "#/$defs/text"},
                      "workload": {"$ref": "#/$defs/text"}, "container": {"$ref": "#/$defs/text"}}}]},
    "cluster_mutation_attempted": {"type": ["boolean", "null"]},
    "previous_image": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]},
    "observed_digests": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/text"}},
    "started_at": {"$ref": "#/$defs/time"},
    "deadline_at": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/time"}]},
    "finished_at": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/time"}]},
    "steps": {"type": "array", "items": {"type": "object", "additionalProperties": false,
              "required": ["step", "status"], "properties": {"step": {"type": "string"}, "status": {"enum": ["ok", "refused", "failed", "skipped"]}, "detail": {"type": "string"}}}},
    "policy": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
               "required": ["state", "renderer_sha256", "previous_s3_json_sha256", "applied_s3_json_sha256", "anonymous_get", "authenticated_get"],
               "properties": {"state": {"const": "closed"}, "renderer_sha256": {"$ref": "#/$defs/hex"},
                              "previous_s3_json_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/hex"}]},
                              "applied_s3_json_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/hex"}]},
                              "anonymous_get": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]},
                              "authenticated_get": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]}}}]}
  },
  "allOf": [
    {"if": {"properties": {"schema_version": {"const": "1.2"}}}, "then": {"required": ["policy"]}},
    {"if": {"properties": {"outcome": {"const": "APPLIED"}}},
     "then": {"properties": {"change": {"type": "object"}, "job_passed": {"const": true},
                             "gate_recheck": {"type": "object"}, "cluster_mutation_attempted": {"const": true},
                             "finished_at": {"$ref": "#/$defs/time"}}}},
    {"if": {"properties": {"outcome": {"const": "APPLIED"}, "change": {"type": "object", "not": {"required": ["change_kind"]}}}},
     "then": {"properties": {"deployed_digest": {"$ref": "#/$defs/digest"}}}},
    {"if": {"properties": {"outcome": {"const": "APPLIED"}, "change": {"type": "object", "required": ["change_kind"]}}},
     "then": {"required": ["policy"],
              "properties": {"deployed_digest": {"type": "null"},
                             "gate_recheck": {"required": ["policy_digest"]},
                             "policy": {"type": "object", "properties": {"anonymous_get": {"const": "DENIED"},
                                                                          "authenticated_get": {"const": "ALLOWED"}}}}}},
    {"if": {"properties": {"outcome": {"const": "REFUSED"}}},
     "then": {"properties": {"deployed_digest": {"type": "null"}, "job_passed": {"const": false}, "gate_recheck": {"type": "null"},
                             "cluster_mutation_attempted": {"const": false}, "finished_at": {"$ref": "#/$defs/time"}}}},
    {"if": {"properties": {"outcome": {"const": "SAFE_HOLD"}}},
     "then": {"properties": {"change": {"type": "object"}, "deployed_digest": {"type": "null"}, "job_passed": {"const": false},
                             "gate_recheck": {"type": "null"}, "cluster_mutation_attempted": {"const": true},
                             "finished_at": {"$ref": "#/$defs/time"}}}},
    {"if": {"properties": {"outcome": {"const": "UNKNOWN"}}},
     "then": {"properties": {"change": {"type": "object"}, "deployed_digest": {"type": "null"}, "job_passed": {"const": false},
                             "gate_recheck": {"type": "null"}, "cluster_mutation_attempted": {"type": "null"},
                             "deadline_at": {"$ref": "#/$defs/time"}, "finished_at": {"type": "null"}}}}
  ],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text": {"type": "string", "maxLength": 512},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"}
  }
}
