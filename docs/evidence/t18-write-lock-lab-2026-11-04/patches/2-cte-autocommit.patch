+# 메시지 쓰기 한 문장. 자동 커밋으로 보내면 잠금부터 커밋까지 서버 안에서 끝난다(왕복 1번).
+# INSERT가 write_lock의 행을 읽으므로 id를 받기 전에 반드시 잠금을 잡는다.
+# 문장 안에서 statement_timeout을 바꿔도 이 문장에는 듣지 않아 lock_timeout으로 대기를 묶는다.
+ADD_MESSAGE = f"""
+    WITH write_lock AS MATERIALIZED (
+        SELECT set_config('lock_timeout', %(timeout)s, true), pg_advisory_xact_lock(%(lock)s)
+    ), inserted AS (
+        INSERT INTO messages (idempotency_key, author, body, attachment_id)
+        SELECT %(key)s::uuid, %(author)s::text, %(body)s::text, %(attachment_id)s::uuid
+        FROM write_lock
+        ON CONFLICT (idempotency_key) DO NOTHING
+        RETURNING *
+    )
+    SELECT {MESSAGE_COLUMNS} FROM inserted m LEFT JOIN attachments a ON a.id = m.attachment_id
+"""
+
+
