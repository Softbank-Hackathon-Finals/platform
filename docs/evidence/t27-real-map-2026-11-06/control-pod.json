{
 "apiVersion": "v1",
 "kind": "Pod",
 "metadata": {
  "labels": {
   "app.kubernetes.io/part-of": "bravo-exit-drill",
   "bravo-exit-drill-control": "true",
   "component": "target"
  },
  "name": "exit-drill-control",
  "namespace": "target-dev"
 },
 "spec": {
  "activeDeadlineSeconds": 14400,
  "automountServiceAccountToken": false,
  "containers": [
   {
    "command": [
     "python",
     "-c",
     "import time; time.sleep(14400)"
    ],
    "image": "localhost/bravo-demo-chat@sha256:b351ba11819796aaea854f742049e46b058561f80c0e738f42c93280af762888",
    "imagePullPolicy": "Never",
    "name": "control",
    "resources": {
     "limits": {
      "cpu": "250m",
      "memory": "128Mi"
     },
     "requests": {
      "cpu": "10m",
      "memory": "32Mi"
     }
    },
    "securityContext": {
     "allowPrivilegeEscalation": false,
     "capabilities": {
      "drop": [
       "ALL"
      ]
     },
     "readOnlyRootFilesystem": true
    }
   }
  ],
  "restartPolicy": "Never",
  "securityContext": {
   "runAsGroup": 10001,
   "runAsNonRoot": true,
   "runAsUser": 10001,
   "seccompProfile": {
    "type": "RuntimeDefault"
   }
  },
  "terminationGracePeriodSeconds": 1
 }
}
