{
  "version": "1",
  "ocsf_version": "1.1.0",
  "description": "출처별 원본 값 → 정규화 값 규칙 (T33 설계 5절). 정규화기는 이 파일만 읽어 결정적으로 변환한다. 규칙을 바꾸면 예시와 테스트를 함께 고친다.",
  "severity": {
    "aws_security_hub": { "field": "Severity.Label", "map": { "INFORMATIONAL": 1, "LOW": 2, "MEDIUM": 3, "HIGH": 4, "CRITICAL": 5 }, "default": 0 },
    "aws_guardduty": { "field": "Severity", "map": {}, "default": 0, "note": "숫자 등급 경계는 공식 문서로 확인한 뒤 채운다. 확정 전에는 Security Hub 경유만 쓴다" },
    "gcp_scc": { "field": "severity", "map": { "LOW": 2, "MEDIUM": 3, "HIGH": 4, "CRITICAL": 5, "SEVERITY_UNSPECIFIED": 0 }, "default": 0 },
    "falco": { "field": "priority", "map": { "Debug": 1, "Informational": 1, "Notice": 2, "Warning": 3, "Error": 4, "Critical": 5, "Alert": 5, "Emergency": 5 }, "case_insensitive": true, "default": 0 },
    "kyverno": { "field": "policy annotation policies.kyverno.io/severity", "map": { "low": 2, "medium": 3, "high": 4, "critical": 5 }, "case_insensitive": true, "default": 3 },
    "bravo_controls": { "field": "verdict", "map": { "FAIL": 4, "UNKNOWN": 3 }, "default": 0, "note": "UNKNOWN은 차단 사유라 낮추지 않는다. PASS는 결과를 만들지 않는다(기존 결과는 Resolved)" }
  },
  "status": {
    "aws_security_hub": {
      "rules": [
        { "field": "RecordState", "equals": "ARCHIVED", "status_id": 4 },
        { "field": "Workflow.Status", "equals": "NEW", "status_id": 1 },
        { "field": "Workflow.Status", "equals": "NOTIFIED", "status_id": 2 },
        { "field": "Workflow.Status", "equals": "SUPPRESSED", "status_id": 3 },
        { "field": "Workflow.Status", "equals": "RESOLVED", "status_id": 4 }
      ],
      "default": 1
    },
    "gcp_scc": {
      "rules": [
        { "field": "state", "equals": "INACTIVE", "status_id": 4 },
        { "field": "mute", "equals": "MUTED", "status_id": 3 }
      ],
      "default": 1
    },
    "falco": { "rules": [], "default": 1, "resolve_if_silent_hours": 24, "note": "이벤트라 상태가 없다. 같은 규칙 · 같은 대상이 정해진 시간 다시 안 나오면 Resolved" },
    "kyverno": {
      "rules": [
        { "field": "result", "equals": "fail", "status_id": 1 },
        { "field": "result", "equals": "warn", "status_id": 1 },
        { "field": "result", "equals": "pass", "status_id": 4 }
      ],
      "drop": ["skip"],
      "collection_error": ["error"],
      "default": 0
    },
    "bravo_controls": {
      "rules": [
        { "field": "verdict", "equals": "FAIL", "status_id": 1 },
        { "field": "verdict", "equals": "UNKNOWN", "status_id": 1 },
        { "field": "verdict", "equals": "PASS", "status_id": 4 }
      ],
      "default": 0
    }
  },
  "class": {
    "description": "class_uid를 정하는 규칙. 위에서부터 처음 맞는 규칙을 쓴다",
    "aws_security_hub": [
      { "field": "Types[]", "prefix": "Software and Configuration Checks/Vulnerabilities/", "class_uid": 2002 },
      { "field": "Types[]", "prefix": "TTPs/", "class_uid": 2004 },
      { "field": "Types[]", "prefix": "Unusual Behaviors/", "class_uid": 2004 },
      { "field": "Types[]", "prefix": "Effects/", "class_uid": 2004 },
      { "field": "Types[]", "prefix": "Software and Configuration Checks/", "class_uid": 2003 },
      { "default": 2004 }
    ],
    "gcp_scc": [
      { "field": "findingClass", "equals": "THREAT", "class_uid": 2004 },
      { "field": "findingClass", "equals": "VULNERABILITY", "class_uid": 2002 },
      { "field": "findingClass", "equals": "MISCONFIGURATION", "class_uid": 2003 },
      { "default": 2004 }
    ],
    "falco": [{ "default": 2004 }],
    "kyverno": [{ "default": 2003 }],
    "bravo_controls": [{ "default": 2003 }]
  },
  "category": {
    "description": "bravo.category를 정하는 규칙. 위에서부터 처음 맞는 규칙을 쓰고, 맞는 규칙이 없으면 class_fallback을 쓴다. 맞지 않은 원본 분류는 unmapped에 남긴다. 아래 출처 고유 값은 첫 규칙이며 실제 수집 결과로 확인 · 보강한다",
    "class_fallback": { "2002": "VULNERABILITY", "2003": "POLICY", "2004": "THREAT" },
    "aws_security_hub": [
      { "field": "Compliance.SecurityControlId", "prefix": "IAM.", "category": "IAM" },
      { "field": "Compliance.SecurityControlId", "prefix": "KMS.", "category": "ENCRYPTION" },
      { "field": "Compliance.SecurityControlId", "prefix": "CloudTrail.", "category": "AUDIT" }
    ],
    "gcp_scc": [
      { "field": "category", "equals": "PUBLIC_BUCKET_ACL", "category": "EXPOSURE" },
      { "field": "category", "equals": "OPEN_FIREWALL", "category": "EXPOSURE" },
      { "field": "category", "equals": "AUDIT_LOGGING_DISABLED", "category": "AUDIT" },
      { "field": "category", "equals": "KMS_KEY_NOT_ROTATED", "category": "ENCRYPTION" },
      { "field": "category", "equals": "MFA_NOT_ENFORCED", "category": "IAM" },
      { "field": "category", "equals": "PRIMITIVE_ROLES_USED", "category": "IAM" }
    ],
    "falco": [],
    "kyverno": [
      { "field": "policy", "equals": "require-run-as-nonroot", "category": "POLICY", "note": "예시. 실제 정책은 T9에서 정해지면 추가한다" }
    ],
    "bravo_controls": [
      { "field": "control_id", "equals": "SEC-01", "category": "ENCRYPTION" },
      { "field": "control_id", "equals": "ENC-02", "category": "ENCRYPTION" },
      { "field": "control_id", "equals": "ENC-01", "category": "ENCRYPTION" },
      { "field": "control_id", "equals": "AUD-01", "category": "AUDIT" },
      { "field": "control_id", "equals": "NET-01", "category": "EXPOSURE" },
      { "field": "control_id", "equals": "IAM-01", "category": "IAM" },
      { "field": "control_id", "equals": "ISO-01", "category": "IAM" },
      { "field": "control_id", "equals": "DR-01", "category": "POLICY" }
    ]
  },
  "source_status": {
    "stale_after_minutes": 15,
    "note": "마지막 성공 수집이 이 시간보다 오래되면 STALE(오래됨). 수집 실패는 FAILED(확인 불가). 0건과 구분한다"
  }
}
