{
  "version": "1",
  "ocsf_version": "1.1.0",
  "description": "출처별 원본 값 → 정규화 값 규칙 (T33 설계 5절). 정규화기는 이 파일만 읽어 결정적으로 변환한다. 규칙을 바꾸면 예시와 테스트를 함께 고친다.",
  "severity": {
    "aws_security_hub": {
      "field": "Severity.Label",
      "map": {
        "INFORMATIONAL": 1,
        "LOW": 2,
        "MEDIUM": 3,
        "HIGH": 4,
        "CRITICAL": 5
      },
      "default": 0
    },
    "aws_guardduty": {
      "field": "Severity",
      "map": {},
      "default": 0,
      "note": "AWS severity bands: Low [1,4), Medium [4,7), High [7,9), Critical [9,10]. Invalid values remain Unknown.",
      "ranges": [
        {
          "min": 1,
          "max_exclusive": 4,
          "severity_id": 2
        },
        {
          "min": 4,
          "max_exclusive": 7,
          "severity_id": 3
        },
        {
          "min": 7,
          "max_exclusive": 9,
          "severity_id": 4
        },
        {
          "min": 9,
          "max_exclusive": 10,
          "max_inclusive": true,
          "severity_id": 5
        }
      ],
      "source": "https://docs.aws.amazon.com/guardduty/latest/ug/guardduty_findings-severity.html"
    },
    "gcp_scc": {
      "field": "severity",
      "map": {
        "LOW": 2,
        "MEDIUM": 3,
        "HIGH": 4,
        "CRITICAL": 5,
        "SEVERITY_UNSPECIFIED": 0
      },
      "default": 0
    },
    "falco": {
      "field": "priority",
      "map": {
        "Debug": 1,
        "Informational": 1,
        "Notice": 2,
        "Warning": 3,
        "Error": 4,
        "Critical": 5,
        "Alert": 5,
        "Emergency": 5
      },
      "case_insensitive": true,
      "default": 0
    },
    "kyverno": {
      "field": "severity",
      "map": {
        "low": 2,
        "medium": 3,
        "high": 4,
        "critical": 5
      },
      "case_insensitive": true,
      "default": 3,
      "note": "PolicyReport 결과의 severity (정책 annotation policies.kyverno.io/severity에서 온다). 없으면 medium"
    },
    "bravo_controls": {
      "field": "result.verdict",
      "map": {
        "FAIL": 4,
        "UNKNOWN": 3
      },
      "default": 0,
      "note": "UNKNOWN은 차단 사유라 낮추지 않는다. PASS는 결과를 만들지 않는다(기존 결과는 Resolved)"
    }
  },
  "status": {
    "aws_security_hub": {
      "rules": [
        {
          "field": "RecordState",
          "equals": "ARCHIVED",
          "status_id": 4
        },
        {
          "field": "Workflow.Status",
          "equals": "NEW",
          "status_id": 1
        },
        {
          "field": "Workflow.Status",
          "equals": "NOTIFIED",
          "status_id": 2
        },
        {
          "field": "Workflow.Status",
          "equals": "SUPPRESSED",
          "status_id": 3
        },
        {
          "field": "Workflow.Status",
          "equals": "RESOLVED",
          "status_id": 4
        }
      ],
      "default": 1
    },
    "gcp_scc": {
      "rules": [
        {
          "field": "state",
          "equals": "INACTIVE",
          "status_id": 4
        },
        {
          "field": "mute",
          "equals": "MUTED",
          "status_id": 3
        }
      ],
      "default": 1
    },
    "falco": {
      "rules": [],
      "default": 1,
      "resolve_if_silent_hours": 24,
      "note": "이벤트라 상태가 없다. 같은 규칙 · 같은 대상이 정해진 시간 다시 안 나오면 Resolved"
    },
    "kyverno": {
      "rules": [
        {
          "field": "result",
          "equals": "fail",
          "status_id": 1
        },
        {
          "field": "result",
          "equals": "warn",
          "status_id": 1
        },
        {
          "field": "result",
          "equals": "pass",
          "status_id": 4
        }
      ],
      "drop": [
        "skip"
      ],
      "collection_error": [
        "error"
      ],
      "default": 0
    },
    "bravo_controls": {
      "rules": [
        {
          "field": "result.verdict",
          "equals": "FAIL",
          "status_id": 1
        },
        {
          "field": "result.verdict",
          "equals": "UNKNOWN",
          "status_id": 1
        },
        {
          "field": "result.verdict",
          "equals": "PASS",
          "status_id": 4
        }
      ],
      "default": 0
    },
    "aws_guardduty": {
      "rules": [
        {
          "field": "Service.Archived",
          "equals": true,
          "status_id": 3
        }
      ],
      "default": 1
    }
  },
  "class": {
    "description": "class_uid를 정하는 규칙. 위에서부터 처음 맞는 규칙을 쓴다",
    "aws_security_hub": [
      {
        "field": "Types[]",
        "prefix": "Software and Configuration Checks/Vulnerabilities/",
        "class_uid": 2002
      },
      {
        "field": "Types[]",
        "prefix": "TTPs/",
        "class_uid": 2004
      },
      {
        "field": "Types[]",
        "prefix": "Unusual Behaviors/",
        "class_uid": 2004
      },
      {
        "field": "Types[]",
        "prefix": "Effects/",
        "class_uid": 2004
      },
      {
        "field": "Types[]",
        "prefix": "Software and Configuration Checks/",
        "class_uid": 2003
      },
      {
        "default": 2004
      }
    ],
    "gcp_scc": [
      {
        "field": "findingClass",
        "equals": "THREAT",
        "class_uid": 2004
      },
      {
        "field": "findingClass",
        "equals": "VULNERABILITY",
        "class_uid": 2002
      },
      {
        "field": "findingClass",
        "equals": "MISCONFIGURATION",
        "class_uid": 2003
      },
      {
        "default": 2004
      }
    ],
    "falco": [
      {
        "default": 2004
      }
    ],
    "kyverno": [
      {
        "default": 2003
      }
    ],
    "bravo_controls": [
      {
        "default": 2003
      }
    ],
    "aws_guardduty": [
      {
        "default": 2004
      }
    ]
  },
  "category": {
    "description": "bravo.category를 정하는 규칙. 위에서부터 처음 맞는 규칙을 쓰고, 맞는 규칙이 없으면 class_fallback을 쓴다. 맞지 않은 원본 분류는 unmapped에 남긴다. 아래 출처 고유 값은 첫 규칙이며 실제 수집 결과로 확인 · 보강한다",
    "class_fallback": {
      "2002": "VULNERABILITY",
      "2003": "POLICY",
      "2004": "THREAT"
    },
    "aws_security_hub": [
      {
        "field": "Compliance.SecurityControlId",
        "prefix": "IAM.",
        "category": "IAM"
      },
      {
        "field": "Compliance.SecurityControlId",
        "prefix": "KMS.",
        "category": "ENCRYPTION"
      },
      {
        "field": "Compliance.SecurityControlId",
        "prefix": "CloudTrail.",
        "category": "AUDIT"
      }
    ],
    "gcp_scc": [
      {
        "field": "category",
        "equals": "PUBLIC_BUCKET_ACL",
        "category": "EXPOSURE"
      },
      {
        "field": "category",
        "equals": "OPEN_FIREWALL",
        "category": "EXPOSURE"
      },
      {
        "field": "category",
        "equals": "AUDIT_LOGGING_DISABLED",
        "category": "AUDIT"
      },
      {
        "field": "category",
        "equals": "KMS_KEY_NOT_ROTATED",
        "category": "ENCRYPTION"
      },
      {
        "field": "category",
        "equals": "MFA_NOT_ENFORCED",
        "category": "IAM"
      },
      {
        "field": "category",
        "equals": "PRIMITIVE_ROLES_USED",
        "category": "IAM"
      }
    ],
    "falco": [],
    "kyverno": [
      {
        "field": "policy",
        "equals": "require-run-as-nonroot",
        "category": "POLICY",
        "note": "예시. 실제 정책은 T9에서 정해지면 추가한다"
      }
    ],
    "bravo_controls": [
      {
        "field": "result.control_id",
        "equals": "SEC-01",
        "category": "ENCRYPTION"
      },
      {
        "field": "result.control_id",
        "equals": "ENC-02",
        "category": "ENCRYPTION"
      },
      {
        "field": "result.control_id",
        "equals": "ENC-01",
        "category": "ENCRYPTION"
      },
      {
        "field": "result.control_id",
        "equals": "AUD-01",
        "category": "AUDIT"
      },
      {
        "field": "result.control_id",
        "equals": "NET-01",
        "category": "EXPOSURE"
      },
      {
        "field": "result.control_id",
        "equals": "IAM-01",
        "category": "IAM"
      },
      {
        "field": "result.control_id",
        "equals": "ISO-01",
        "category": "IAM"
      },
      {
        "field": "result.control_id",
        "equals": "DR-01",
        "category": "POLICY"
      }
    ],
    "aws_guardduty": []
  },
  "source_status": {
    "stale_after_minutes": 15,
    "push_sources": [
      "falco",
      "kyverno",
      "bravo_controls"
    ],
    "note": "끌어오는 출처는 마지막 성공 수집, 밀어 넣는 출처(온프렘 에이전트 · 웹훅 · T5)는 마지막 인증된 수신 또는 heartbeat가 이 시간보다 오래되면 STALE(오래됨). 인증된 에이전트가 오류를 보고하거나 끌어오기가 실패하면 FAILED(확인 불가). 미인증 요청은 상태를 바꾸지 않는다"
  },
  "compliance_status": {
    "description": "Compliance Finding(2003)의 compliance.status. 원본 값 → Pass · Warning · Fail",
    "aws_security_hub": {
      "field": "Compliance.Status",
      "map": {
        "PASSED": "Pass",
        "WARNING": "Warning",
        "FAILED": "Fail",
        "NOT_AVAILABLE": "Warning"
      },
      "default": "Fail"
    },
    "gcp_scc": {
      "field": "state",
      "map": {
        "ACTIVE": "Fail",
        "INACTIVE": "Pass"
      },
      "default": "Fail"
    },
    "kyverno": {
      "field": "result",
      "map": {
        "fail": "Fail",
        "warn": "Warning",
        "pass": "Pass"
      },
      "default": "Fail"
    },
    "bravo_controls": {
      "field": "result.verdict",
      "map": {
        "FAIL": "Fail",
        "UNKNOWN": "Warning",
        "PASS": "Pass"
      },
      "default": "Fail"
    }
  },
  "upsert_key": [
    "bravo.source",
    "bravo.environment_id",
    "finding_info.uid"
  ],
  "coverage": {
    "description": "출처가 볼 수 있는 범주. 환경에 등록된 출처 중 그 범주를 보는 출처가 없으면 칸은 '없음'이다",
    "aws_security_hub": [
      "IAM",
      "ENCRYPTION",
      "AUDIT",
      "EXPOSURE",
      "POLICY",
      "THREAT",
      "VULNERABILITY"
    ],
    "aws_guardduty": [
      "THREAT"
    ],
    "gcp_scc": [
      "IAM",
      "ENCRYPTION",
      "AUDIT",
      "EXPOSURE",
      "POLICY",
      "THREAT",
      "VULNERABILITY"
    ],
    "falco": [
      "THREAT"
    ],
    "kyverno": [
      "POLICY",
      "IAM",
      "ENCRYPTION",
      "EXPOSURE"
    ],
    "bravo_controls": [
      "IAM",
      "ENCRYPTION",
      "AUDIT",
      "EXPOSURE",
      "POLICY"
    ]
  },
  "capabilities": {
    "description": "탐지 능력 표의 행 (설계 6절). 환경에 등록된 출처 중 아래 출처가 있으면 그 능력이 있다",
    "rows": [
      {
        "id": "runtime_threat",
        "name": "런타임 위협 (컨테이너 · 호스트)",
        "sources": [
          "aws_security_hub",
          "aws_guardduty",
          "gcp_scc",
          "falco"
        ]
      },
      {
        "id": "network_threat",
        "name": "네트워크 · API 위협",
        "sources": [
          "aws_security_hub",
          "aws_guardduty",
          "gcp_scc"
        ]
      },
      {
        "id": "misconfiguration",
        "name": "설정 · 정책 위반",
        "sources": [
          "aws_security_hub",
          "gcp_scc",
          "kyverno",
          "bravo_controls"
        ]
      },
      {
        "id": "vulnerability",
        "name": "취약점",
        "sources": [
          "aws_security_hub",
          "gcp_scc"
        ]
      },
      {
        "id": "migration_parity",
        "name": "이전 전후 통제 비교",
        "sources": [
          "bravo_controls"
        ]
      }
    ]
  },
  "falco_lifecycle": {
    "automatic_silence_resolution": false,
    "closure_requires": "verified remediation or separately authorized incident closure; not implemented by T33"
  }
}
