{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "sourceRevision", "tenantId", "audience", "tokenReview", "database", "secrets", "configMaps", "audit", "resources"],
  "definitions": {
    "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"},
    "ipv4": {"type": "string", "format": "ipv4"}
  },
  "properties": {
    "image": {
      "type": "object", "additionalProperties": false, "required": ["repository", "digest"],
      "properties": {
        "repository": {"const": "ghcr.io/softbank-hackathon-finals/platform-security-review"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "sourceRevision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "tenantId": {"$ref": "#/definitions/name"},
    "audience": {"const": "registered-security-review-audience"},
    "tokenReview": {
      "type": "object", "additionalProperties": false,
      "required": ["origin", "apiAddress", "apiPort", "reviewerAudience"],
      "properties": {
        "origin": {"const": "https://kubernetes.default.svc:443"},
        "apiAddress": {"$ref": "#/definitions/ipv4"},
        "apiPort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "reviewerAudience": {"type": "string", "pattern": "^https://[a-z0-9.-]+(?::[0-9]+)?$"}
      }
    },
    "database": {
      "type": "object", "additionalProperties": false, "required": ["address", "port"],
      "properties": {
        "address": {"$ref": "#/definitions/ipv4"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "podSelector": {
          "type": "object",
          "oneOf": [
            {"maxProperties": 0},
            {
              "additionalProperties": false,
              "required": ["cnpg.io/cluster", "cnpg.io/instanceRole"],
              "properties": {
                "cnpg.io/cluster": {"$ref": "#/definitions/name"},
                "cnpg.io/instanceRole": {"const": "primary"}
              }
            }
          ]
        }
      }
    },
    "secrets": {
      "type": "object", "additionalProperties": false, "required": ["tls", "database", "registry"],
      "properties": {"tls": {"$ref": "#/definitions/name"}, "database": {"$ref": "#/definitions/name"}, "registry": {"$ref": "#/definitions/name"}}
    },
    "configMaps": {
      "type": "object", "additionalProperties": false, "required": ["grants", "apiCA"],
      "properties": {"grants": {"$ref": "#/definitions/name"}, "apiCA": {"$ref": "#/definitions/name"}}
    },
    "audit": {
      "type": "object", "additionalProperties": false, "required": ["storageClassName", "size"],
      "properties": {"storageClassName": {"$ref": "#/definitions/name"}, "size": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$"}}
    },
    "resources": {"type": "object"}
  }
}
