{
  "publicEntry": {
    "enabled": true
  },
  "argo-cd": {
    "server": {
      "enabled": true,
      "replicas": 1,
      "resources": {
        "requests": {
          "cpu": "50m",
          "memory": "128Mi"
        },
        "limits": {
          "cpu": "500m",
          "memory": "256Mi"
        }
      }
    },
    "configs": {
      "params": {
        "server.insecure": true
      },
      "cm": {
        "url": "https://platform-argocd.mangowhois.ai",
        "users.anonymous.enabled": "true"
      },
      "rbac": {
        "policy.default": "role:platform-viewer",
        "policy.csv": "p, role:platform-viewer, applications, get, */*, allow\np, role:platform-viewer, projects, get, *, allow\np, role:platform-viewer, applications, get, platform-registration/*, deny\np, role:platform-viewer, applications, get, platform-rehearsal-host/*, deny\n"
      },
      "clusterCredentials": {
        "platform": {
          "namespaces": "platform-state,bravo-observability,platform-telemetry"
        }
      }
    }
  },
  "observability": {
    "enabled": true
  }
}
