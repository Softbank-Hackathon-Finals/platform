#!/usr/bin/env bash
set -euo pipefail
# No credentials pass through this script: an admin approves the login URL the join prints.
export DEBIAN_FRONTEND=noninteractive
# Ubuntu cloud images use HTTP apt mirrors by default; this host only sends HTTPS over TCP.
sed -i -E 's|http://[^ /]*ports.ubuntu.com/ubuntu-ports|https://ports.ubuntu.com/ubuntu-ports|g' /etc/apt/sources.list.d/ubuntu.sources
apt-get update -qq
apt-get install -y -qq ca-certificates curl

curl --fail --silent --show-error --location --retry 3 https://pkgs.tailscale.com/stable/ubuntu/noble.noarmor.gpg -o /usr/share/keyrings/tailscale-archive-keyring.gpg
echo '3e03dacf222698c60b8e2f990b809ca1b3e104de127767864284e6c228f1fb39  /usr/share/keyrings/tailscale-archive-keyring.gpg' | sha256sum -c -
echo 'deb [signed-by=/usr/share/keyrings/tailscale-archive-keyring.gpg] https://pkgs.tailscale.com/stable/ubuntu noble main' >/etc/apt/sources.list.d/tailscale.list
apt-get update -qq
apt-get install -y -qq tailscale=1.104.4

# The join prints a login URL; an admin (owner of the relay tag) opens it. Then the relay server starts.
# shields-up: the relay forwards UDP between peers; nothing reaches this host inside the tunnel.
cat >/usr/local/sbin/bravo-tailnet-join <<'JOIN'
#!/bin/sh
set -eu
tailscale up --advertise-tags='${tailscale_tag}' --hostname='${hostname}' --shields-up --timeout=15m
exec tailscale set --relay-server-port='${relay_port}'
JOIN
chmod 0700 /usr/local/sbin/bravo-tailnet-join
touch /var/lib/bravo-relay-ready
