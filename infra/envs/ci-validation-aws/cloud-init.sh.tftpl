#!/bin/bash
set -euo pipefail
umask 077
mkdir -p /opt/bravo-validation

# Termination remains bounded even if bootstrap or the operator disappears.
systemd-run --unit=bravo-validation-expiry --on-active=${ttl_minutes}m /sbin/shutdown -h now

# Only outbound HTTPS is open; Canonical's default HTTP mirrors also serve HTTPS.
sed -i 's|http://|https://|g' /etc/apt/sources.list.d/ubuntu.sources
# Regional ARM mirror aliases do not all have matching TLS certificates.
sed -E -i 's|https://[^/]*ports\.ubuntu\.com/ubuntu-ports|https://ports.ubuntu.com/ubuntu-ports|g' /etc/apt/sources.list.d/ubuntu.sources
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get install -y -qq ca-certificates curl python3 python3-venv git

python3 -m venv /opt/bravo-validation/venv
/opt/bravo-validation/venv/bin/pip install --disable-pip-version-check 'uv==0.9.5'
ln -s /opt/bravo-validation/venv/bin/uv /usr/local/bin/uv

curl --fail --silent --show-error --location \
  'https://raw.githubusercontent.com/k3s-io/k3s/v1.35.5+k3s1/install.sh' \
  -o /opt/bravo-validation/install-k3s.sh
echo '8598e002e61d658fed7b7542fc6d2c66d8da6eae69e088830105d2ee1ffb6d91  /opt/bravo-validation/install-k3s.sh' | sha256sum -c -
INSTALL_K3S_VERSION='v1.35.5+k3s1' \
INSTALL_K3S_EXEC='server --disable traefik --disable servicelb --write-kubeconfig-mode 600' \
  sh /opt/bravo-validation/install-k3s.sh

timeout 180 sh -c 'until kubectl get node -o jsonpath="{.items[0].status.conditions[?(@.type==\"Ready\")].status}" | grep -q True; do sleep 3; done'
kubectl version -o json > /opt/bravo-validation/kubernetes-version.json
date -u +%FT%TZ > /opt/bravo-validation/ready
