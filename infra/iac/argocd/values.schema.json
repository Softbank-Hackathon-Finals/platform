{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["environment", "tailnet", "repoURL", "targetRevision"],
  "properties": {
    "environment": {"type": "string", "enum": ["platform", "source-dev", "target-dev"]},
    "tailnet": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.ts\\.net$"},
    "repoURL": {"type": "string", "pattern": "^https://github\\.com/Softbank-Hackathon-Finals/platform\\.git$"},
    "targetRevision": {"type": "string", "pattern": "^[A-Za-z0-9._/-]{1,100}$"}
  }
}
