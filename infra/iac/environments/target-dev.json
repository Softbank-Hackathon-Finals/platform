{
  "schema_version": "1",
  "environment": "target-dev",
  "modules": [
    {
      "id": "target-object-exposure",
      "version": "1",
      "params": {
        "state": "open-demo",
        "bucket": "demo-chat-attachments",
        "demo_run_id": "demo-2026-11-08"
      }
    },
    {
      "id": "tailnet-egress",
      "version": "1",
      "params": {
        "owner_tag": "tag:bravo-target-operator",
        "groups": [
          {
            "name": "bravo-target-collector",
            "tag": "tag:bravo-target-collector",
            "clients": [
              {
                "namespace": "bravo-observability",
                "labels": {
                  "app": "bravo-collector"
                }
              }
            ],
            "routes": [
              {
                "service": "bravo-metrics",
                "namespace": "bravo-observability",
                "destination": "bravo-metrics",
                "destination_tag": "tag:bravo-metrics",
                "port": 9090,
                "port_name": "otlp"
              }
            ]
          },
          {
            "name": "bravo-target-replication",
            "tag": "tag:bravo-target-replication",
            "client_policy": false,
            "clients": [
              {
                "namespace": "target-dev",
                "labels": {
                  "cnpg.io/cluster": "target-db"
                }
              }
            ],
            "routes": [
              {
                "service": "source-db-for-replication",
                "namespace": "target-dev",
                "destination": "bravo-source-db",
                "destination_tag": "tag:bravo-source-db",
                "port": 5432,
                "port_name": "postgres"
              }
            ]
          },
          {
            "name": "bravo-target-pooler",
            "tag": "tag:bravo-target-pooler",
            "client_policy": false,
            "clients": [
              {
                "namespace": "target-dev",
                "labels": {
                  "app": "target-pgbouncer"
                }
              }
            ],
            "routes": [
              {
                "service": "source-db-for-pooler",
                "namespace": "target-dev",
                "destination": "bravo-source-db",
                "destination_tag": "tag:bravo-source-db",
                "port": 5432,
                "port_name": "postgres"
              }
            ]
          },
          {
            "name": "bravo-target-findings",
            "tag": "tag:bravo-target-findings",
            "clients": [
              {
                "namespace": "bravo-security",
                "labels": {
                  "app.kubernetes.io/name": "bravo-findings-agent",
                  "bravo.dev/findings-client": "agent"
                }
              },
              {
                "namespace": "falco",
                "labels": {
                  "app.kubernetes.io/instance": "falco",
                  "app.kubernetes.io/name": "falcosidekick"
                }
              }
            ],
            "routes": [
              {
                "service": "bravo-findings",
                "namespace": "bravo-security",
                "destination": "bravo-findings",
                "destination_tag": "tag:bravo-findings",
                "port": 8443,
                "port_name": "https"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "tailnet-ingress",
      "version": "1",
      "params": {
        "owner_tag": "tag:bravo-target-operator",
        "devices": [
          {
            "service": "target-db-tailnet",
            "namespace": "target-dev",
            "hostname": "bravo-target-db",
            "tag": "tag:bravo-target-db",
            "selector": {
              "cnpg.io/cluster": "target-db",
              "cnpg.io/instanceRole": "primary"
            },
            "ports": [
              {
                "name": "postgres",
                "port": 5432,
                "target_port": 5432
              }
            ]
          },
          {
            "service": "target-control-pooler-tailnet",
            "namespace": "target-dev",
            "hostname": "bravo-target-control-pooler",
            "tag": "tag:bravo-target-control-pooler",
            "selector": {
              "app": "target-pgbouncer"
            },
            "ports": [
              {
                "name": "pooler",
                "port": 6432,
                "target_port": 5432
              }
            ]
          },
          {
            "service": "target-objects-tailnet",
            "namespace": "target-dev",
            "hostname": "bravo-target-objects",
            "tag": "tag:bravo-target-objects",
            "selector": {
              "app.kubernetes.io/name": "target-seaweedfs"
            },
            "ports": [
              {
                "name": "s3",
                "port": 8333,
                "target_port": 8333
              }
            ]
          },
          {
            "service": "bravo-target-argocd",
            "namespace": "bravo-iac-gitops",
            "hostname": "bravo-target-argocd",
            "tag": "tag:bravo-target-argocd",
            "selector": {
              "app.kubernetes.io/name": "argocd-server",
              "app.kubernetes.io/instance": "bravo-iac-gitops"
            },
            "ports": [
              {
                "name": "http",
                "port": 80,
                "target_port": 8080
              }
            ]
          }
        ]
      }
    },
    {
      "id": "cluster-audit",
      "version": "1",
      "params": {
        "runtime": "rke2",
        "policy": "metadata-v1"
      }
    },
    {
      "id": "operator-access",
      "version": "1",
      "params": {
        "proxy_hostname": "bravo-target-operator",
        "proxy_tag": "tag:bravo-target-operator",
        "bindings": [
          {
            "name": "bravo-operators-cluster-admin",
            "group": "bravo:operators",
            "cluster_role": "cluster-admin",
            "tailnet_groups": [
              "autogroup:admin",
              "autogroup:owner",
              "group:bravo-operators"
            ]
          }
        ],
        "legacy_reach": [
          "group:bravo-b-cluster"
        ]
      }
    }
  ]
}
