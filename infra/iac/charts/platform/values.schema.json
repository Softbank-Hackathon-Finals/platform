{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "tailnet": {
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.ts\\.net$",
      "type": "string"
    },
    "tailnets": {
      "additionalProperties": false,
      "properties": {
        "workload": {
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.ts\\.net$",
          "type": "string"
        }
      },
      "required": [
        "workload"
      ],
      "type": "object"
    }
  },
  "required": [
    "tailnet",
    "tailnets"
  ],
  "type": "object"
}
